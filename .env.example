# Home Assistant base URL as seen from inside the container
HA_URL=http://homeassistant:8123
# HA profile -> Security -> Long-lived access tokens
HA_TOKEN=replace-me
APP_USER=admin
APP_PASSWORD=change-me
# Optional: signs login cookies. If unset, one is generated and stored next to DB_PATH.
# SESSION_SECRET=
DB_PATH=/data/layout.db
# Host port for dockge/compose.yaml (bound to 127.0.0.1)
WEB_PORT=8078
