# Settings for the homecontrol CI runner VMs: ONE file read by OpenTofu (main.tf) and, for the runner keys only, by Docker
# Compose inside the VM.
#
# Create .env ONLY in a clone OUTSIDE Google Drive / OneDrive (main.tf "USE"), never in the Drive-synced project
# folder: .gitignore keeps it out of git but not out of Drive, and it holds a local administrator's password.
#   git clone https://github.com/aaronbuster19-coder/homecontrol C:\HomecontrolCI\src
#   cd C:\HomecontrolCI\src\ci-runner
#   copy .env.example .env      (PowerShell: Copy-Item .env.example .env)
#   notepad .env                fill in every value below
#
# NEVER COMMIT .env. It holds secrets; the repo's .gitignore already ignores .env (this file is .env.example).
# Only this .env.example, with placeholders, belongs in git.
#
# Format: KEY=value, one per line. No quotes needed (surrounding quotes are stripped), no spaces around "=", no
# comment after a value on the same line (a "#" there becomes part of the value), and each key once.
# main.tf refuses to run while a value still starts with "change-me" or "paste-".

# ---------------------------------------------------------------------------------------------------------------------
# Hyper-V and WinRM: used by OpenTofu on Windows only. Never copied into the VM.
# ---------------------------------------------------------------------------------------------------------------------

# The local administrator account the taliesins/hyperv provider logs in as over WinRM: this project's own
# homecontrol-tofu, in Administrators and Hyper-V Administrators (main.tf header, step 3). Not Luna's luna-tofu.
# A local account, not your Microsoft one.
HYPERV_USER=homecontrol-tofu

# SECRET. That account's password. The provider writes it into a temporary script in the account's %TEMP% for each
# step and deletes it afterwards, except after a failed step (main.tf "Known traps").
HYPERV_PASSWORD=change-me-long-random-password

# SECRET. Encrypts THIS stack's OpenTofu state, which holds the runner token. At least 16 characters, and NOT Luna's
# passphrase (two stacks, two states, two passphrases). Losing it means the state can't be read: you would then delete
# the homecontrol-ci* VMs and VM_DIR by hand and start again. (Never the LunaCI switch or NAT: they are Luna's.)
STATE_PASSPHRASE=change-me-at-least-16-characters

# Folder on a local NTFS disk for everything the VM needs: state, image, disk, seed ISO. Absolute, with backslashes,
# no trailing backslash. NOT inside this repo and NOT in a synced (Google Drive / OneDrive) folder (main.tf checks).
# This project's OWN folder, never Luna's C:\Hyper-V\LunaCI (main.tf refuses that): its own state lives here.
# Make it, with its cidata subfolder, before `tofu apply`:  New-Item -ItemType Directory -Force C:\Hyper-V\HomecontrolCI\cidata
VM_DIR=C:\Hyper-V\HomecontrolCI

# Full path of qemu-img.exe, which converts Ubuntu's QCOW2 cloud image into a Hyper-V VHDX (main.tf header, step 4).
# This is where `winget install --exact --id SoftwareFreedomConservancy.QEMU` puts it.
QEMU_IMG=C:\Program Files\qemu\qemu-img.exe

# ---------------------------------------------------------------------------------------------------------------------
# Runner: copied into the VM (/opt/homecontrol-ci-runner/.env, mode 600) for docker-compose.yml. Changing any of these and
# running `tofu apply` rebuilds the VM with a clean disk.
# ---------------------------------------------------------------------------------------------------------------------

# The repository the runner serves.
REPO_URL=https://github.com/aaronbuster19-coder/homecontrol

# SECRET (short-lived). The registration token: GitHub > the repository > Settings > Actions > Runners >
# New self-hosted runner, then copy the value after --token in the "Configure" step. It EXPIRES ONE HOUR after you
# open that page, and the VM must register within that hour (first boot takes about 10-20 minutes), so fetch it
# right before `tofu apply -parallelism=1`. Until it expires it can register more runners, and jobs in the VM can read it, so after
# first boot check that Settings > Actions > Runners lists only your runners (RUNNER_NAME, RUNNER_NAME-2 ... up to
# RUNNER_COUNT). After registering, the registration is kept inside the VM. Leave the old value here: blanking it
# counts as a change and would rebuild the VMs. Every rebuild needs a fresh token.
RUNNER_TOKEN=paste-the-registration-token-here

# How many runners (one VM each, 1 to 4): jobs run in parallel, one per runner. Each VM takes 2 vCPU and MEMORY_MB
# of memory all the time, on top of Luna's VMs (check free memory first: [math]::Round((Get-CimInstance Win32_OperatingSystem).FreePhysicalMemory/1MB,1)).
# Runner N is VM homecontrol-ci-N at 192.168.250.(IP_FIRST+N-1) and RUNNER_NAME-N in GitHub; runner 1 has the plain names. One
# RUNNER_TOKEN registers them all if they boot within its hour. Raising the number needs a fresh RUNNER_TOKEN for the
# new VMs, and a new token rebuilds the existing ones too (clean disks, same names: they re-register with it).
# Lowering it removes the highest-numbered VMs and touches nothing else (remove those runners in GitHub too).
RUNNER_COUNT=3

# First address of this project's block on Luna's 192.168.250.0/24 switch: the VMs get IP_FIRST, IP_FIRST+1, ...
# Luna's VMs use .10-.13 and the modelm runner .20; main.tf refuses any overlap with those (local.taken in main.tf).
IP_FIRST=30

# Memory per VM, in MB (1024 to 8192, static). 1024 x 3 VMs = 3 GB held all the time. Each VM also has a 4 GB swap
# file. Raise it (and rebuild with a fresh token) if jobs are OOM-killed (exit code 137) or the e2e job crawls.
MEMORY_MB=1024

# The runner's name in Settings > Actions > Runners. A rebuild re-registers under the same name (it replaces the
# old entry).
RUNNER_NAME=homecontrol-ci-hyperv

# No EPHEMERAL / ACCESS_TOKEN settings, on purpose. Ephemeral runners need a fine-grained personal access token
# (GitHub > your avatar > Settings > Developer settings > Fine-grained tokens, "Administration: Read and write" on this
# repository) to mint a new registration token after every job. That permission can also delete the repository or add
# deploy keys, every job in the VM could read the token, and ephemeral mode would still not reset the VM. For a clean
# machine, rebuild instead: fresh RUNNER_TOKEN + `tofu apply` (main.tf "CHANGES AND RESETS").
